# Google Gemini (Default - Low Cost & Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hugging Face Open-Source Models (e.g., Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.3-70B-Instruct, deepseek-ai/DeepSeek-R1-Distill-Qwen-32B, mistralai/Mistral-7B-Instruct-v0.3)
HF_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
